4:T411,{"@context":"https://schema.org","@type":"MedicalClinic","name":"Dr. Maharana Bone & Joint Clinic","alternateName":"Maharana Bone & Joint Clinic","url":"https://drpradeeptamaharana.com","logo":"https://drpradeeptamaharana.com/images/logo-circle.png","image":"https://drpradeeptamaharana.com/images/clinic.jpg","telephone":"+919937012543","email":"contact@drpradeeptamaharana.com","medicalSpecialty":["Orthopedic","SportsMedicine","Surgical"],"address":{"@type":"PostalAddress","streetAddress":"Modern Health Care, Ekamra Marg, Near Airport New Road, Unit-6, Ganga Nagar","addressLocality":"Bhubaneswar","addressRegion":"Odisha","postalCode":"751001","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":"20.2520","longitude":"85.8230"},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"18:00","closes":"22:00"}],"priceRange":"₹₹","hasMap":"https://maps.google.com/?q=Dr+Maharana+bone+and+joint+clinic+Bhubaneswar"}5:Tc6c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What conditions does Dr. Pradeepta Kumar Maharana treat?","acceptedAnswer":{"@type":"Answer","text":"Dr. Maharana specializes in comprehensive bone and joint care including: knee pain and arthritis, sports injuries (ACL, PCL, meniscus tears), shoulder pain and rotator cuff injuries, back and neck disc problems, acute fractures and trauma fixation, joint stiffness, and non-surgical joint preservation."}},{"@type":"Question","name":"What are the clinic OPD consultation timings?","acceptedAnswer":{"@type":"Answer","text":"Dr. Maharana Bone & Joint Clinic is open all days of the week from 6:00 PM to 10:00 PM at Modern Health Care, Ekamra Marg, Near Airport New Road, Unit-6, Ganga Nagar, Bhubaneswar."}},{"@type":"Question","name":"Can I book an appointment online or walk in directly?","acceptedAnswer":{"@type":"Answer","text":"Yes, you can request an appointment online through our booking form on this website, call +91 99370 12543, or send a WhatsApp message. Walk-in patients are also welcome during evening clinic hours (6:00 PM – 10:00 PM)."}},{"@type":"Question","name":"What documents and reports should I bring for my consultation?","acceptedAnswer":{"@type":"Answer","text":"Please bring all previous medical records, past prescriptions, physical X-ray films, CT scans, and MRI reports/films if you have had them done. If you take medications for blood pressure, diabetes, or blood thinners, please bring the current list."}},{"@type":"Question","name":"Do I definitely need surgery if I visit an orthopaedic surgeon?","acceptedAnswer":{"@type":"Answer","text":"No. At Dr. Maharana Bone & Joint Clinic, surgery is considered only one of several treatment alternatives and never the first reflex. The doctor thoroughly evaluates conservative options first, including specialized physiotherapy, viscosupplementation (gel injections), bracing, and lifestyle modifications."}},{"@type":"Question","name":"Is insurance or cashless mediclaim accepted for surgeries?","acceptedAnswer":{"@type":"Answer","text":"Yes, cashless hospitalization and mediclaim reimbursement support are available through affiliated NABH-accredited tertiary care hospitals in Bhubaneswar where Dr. Maharana performs surgical procedures. Please call our clinic team at +91 99370 12543 to verify your specific insurer and TPA policy."}},{"@type":"Question","name":"What is the recovery time after Robotic Knee Replacement?","acceptedAnswer":{"@type":"Answer","text":"Thanks to sub-millimeter robotic precision and our Rapid Recovery protocol, patients typically begin standing and walking with support on Day 1. Most patients return to light household activities within 2 to 4 weeks, with full active mobility restored within 8 to 12 weeks."}},{"@type":"Question","name":"How does FIFA-certified sports medicine benefit an athlete?","acceptedAnswer":{"@type":"Answer","text":"FIFA certification guarantees international evidence-based standards in injury diagnosis, pitch-side recovery protocols, biomechanical screening, and objective criteria-based return-to-sport testing to prevent re-injury."}}]}0:["wyBWZsCGqfPRhfA2uiQx9",[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"props":{"params":{},"searchParams":{}},"Component":"$3"}],null],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/848c941fef343f62.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"scroll-smooth","children":[["$","head",null,{"children":["$","link",null,{"rel":"icon","href":"/images/logo-circle.png","type":"image/png"}]}],["$","body",null,{"className":"antialiased text-navy-900 bg-white selection:bg-gold-500 selection:text-navy-950","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$4"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Physician\",\"name\":\"Dr. Pradeepta Kumar Maharana\",\"alternateName\":\"Dr. Pradeepta Kumar Moharana\",\"jobTitle\":\"Consultant Orthopaedic & Robotic Joint Replacement Surgeon\",\"medicalSpecialty\":\"OrthopedicSurgery\",\"alumniOf\":[\"DNB Orthopaedics\",\"MBBS\"],\"knowsAbout\":[\"Robotic Knee Replacement\",\"Total Knee Replacement\",\"Partial Knee Replacement\",\"Knee Arthroscopy\",\"Shoulder Arthroscopy\",\"ACL Reconstruction\",\"Sports Medicine\",\"Fracture Trauma Fixation\",\"Non-Surgical Joint Preservation\"],\"worksFor\":{\"@type\":\"MedicalClinic\",\"name\":\"Dr. Maharana Bone & Joint Clinic\"},\"telephone\":\"+919937012543\",\"email\":\"contact@drpradeeptamaharana.com\",\"image\":\"https://drpradeeptamaharana.com/images/doctor-scrubs.jpg\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Modern Health Care, Ekamra Marg, Unit-6, G